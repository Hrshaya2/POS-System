# ============================================
# Nangi POS - Backend Environment Configuration
# ============================================
# For Vercel deployment, add these to:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# For local development, copy to `.env`

# --- MongoDB Atlas (REQUIRED for Vercel) ---
# MongoDB is now the PRIMARY database (replaces SQLite for Vercel)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/nangi_pos

# --- JWT Secret ---
# Used to sign and verify login tokens.
# IMPORTANT: Change this to a long, random string in production!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string

# --- Discount Approval Limit ---
# When a cashier applies a discount percentage higher than this value,
# the sale will require admin/shop-owner approval.
SALE_DISCOUNT_APPROVAL_LIMIT_PERCENT=10

# --- Server Port (Local only, not used on Vercel) ---
PORT=5000