# ============================================
# Nangi POS - Backend Environment Configuration
# ============================================
# Copy this file to `.env` (the installer does this automatically).
# Do NOT commit your real `.env` file to version control.

# --- Server Port ---
# The port the backend API server will listen on.
# The frontend is hardcoded to call http://localhost:5000/api, so
# keep this as 5000 unless you also update the frontend code.
PORT=5000

# --- JWT Secret ---
# Used to sign and verify login tokens.
# IMPORTANT: Change this to a long, random string in production!
# You can generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string

# --- MongoDB (OPTIONAL - Cloud Sync) ---
# If you want to sync data to MongoDB Atlas, paste your connection string here.
# Leave this EMPTY to run fully offline with SQLite only (recommended for single-machine use).
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/nangi_pos
MONGO_URI=

# --- Discount Approval Limit ---
# When a cashier applies a discount percentage higher than this value,
# the sale will require admin/shop-owner approval.
# Default is 10 (meaning discounts above 10% need approval).
SALE_DISCOUNT_APPROVAL_LIMIT_PERCENT=10